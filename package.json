{
  "name": "mandi-software",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "lint": "pnpm --filter frontend lint && prettier --check . && cd backend && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "pnpm --filter frontend typecheck",
    "test": "pnpm --filter frontend test && cd backend && cargo test --workspace",
    "gen:types": "node scripts/gen-types.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "seed": "node scripts/seed/run.mjs",
    "perf": "node scripts/perf/run.mjs",
    "e2e": "node frontend/tests/e2e/run.mjs"
  },
  "devDependencies": {
    "@fluent/syntax": "0.19.0",
    "@tauri-apps/cli": "2.12.1",
    "prettier": "3.9.10"
  }
}
