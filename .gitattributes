# Keep LF line endings on every machine, including the Windows CI runner.
# Without this, Git on Windows checks files out with CRLF and
# `cargo fmt --check` and Prettier fail on files nobody changed.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never change line endings, never diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.xlsx binary
*.mp4 binary
*.db binary
*.sqlite binary

# Generated by `pnpm gen:types` from Rust. Collapsed in GitHub diffs.
frontend/src/bindings/** linguist-generated=true
pnpm-lock.yaml linguist-generated=true
Cargo.lock linguist-generated=true
