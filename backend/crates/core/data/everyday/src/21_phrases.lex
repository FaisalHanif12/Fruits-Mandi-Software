# Common phrases. A phrase is matched as a whole when the text holds it, and a two-word phrase
# also tells which word to take after the word before it (کہا کہ, not کہا کے).

@w 92
# compound verbs
لے کر = le_kar ly_kr lay_kar ly_kar le_kr lay_kr
لے کے = le_ke ly_ke lay_ke
لے گیا = le_gaya ly_gya le_gya lay_gaya ly_gaya ly_gia
لے گئے = le_gaye ly_gye le_gye lay_gaye ly_gaye ly_gae le_gae
لے گئی = le_gai ly_gai le_gayi ly_gayi
لے آیا = le_aya ly_aya lay_aya
لے آئے = le_aye ly_aye lay_aye
دے دیا = de_diya dy_dia de_dia de_dya dy_diya
دے دیے = de_diye dy_diye de_die
دے دی = de_di dy_di
دے دو = de_do dy_do
دے دیں = de_dein de_den dy_den
دے گیا = de_gaya dy_gya
دے کر = de_kar dy_kr de_kr
ہو گیا = ho_gaya ho_gya ho_gia ho_gaia
ہو گئی = ho_gai ho_gayi ho_gaee
ہو گئے = ho_gaye ho_gye ho_gae
چلا گیا = chala_gaya chla_gya chala_gya chala_gia
چلی گئی = chali_gai chali_gayi
چلے گئے = chale_gaye chalay_gye chale_gye
آ گیا = aa_gaya a_gaya aa_gya a_gya a_gia
آ گئے = aa_gaye aa_gye a_gye
آ گئی = aa_gai aa_gayi a_gai
رہ گیا = reh_gaya reh_gya rah_gaya rah_gya
رہ گئے = reh_gaye reh_gye
رہ گئی = reh_gai reh_gayi
مل گیا = mil_gaya mil_gya
مل گئے = mil_gaye mil_gye
مل گئی = mil_gai mil_gayi
بک گیا = bik_gaya bik_gya
بک گئے = bik_gaye bik_gye
کر لیا = kar_liya kr_lia kar_lia kr_liya
کر دیا = kar_diya kr_dia kar_dia kr_diya
کر دی = kar_di kr_di
کر دیے = kar_diye kr_diye
کر گیا = kar_gaya kr_gya
کر گئے = kar_gaye kr_gae kr_gaye kr_gye
کر کے = kar_ke kr_k kar_k kr_ke
کر رہا = kar_raha kr_rha kar_rha
واپس کر دیا = wapas_kar_diya wapis_kr_dia
واپس کر دیے = wapas_kar_diye wapis_kr_diye
ادا کر دیا = ada_kar_diya ada_kr_dia
جمع کروایا = jama_karwaya jama_krwaya jma_krwaya
جمع کرا دیا = jama_kara_diya

# کہ after a verb of saying or knowing
کہا کہ = kaha_ke kaha_keh kaha_k kaha_ki
بتایا کہ = bataya_ke bataya_keh bataya_k btaya_k bataya_ki
لکھا کہ = likha_ke likha_ki likha_keh
ہے کہ = hai_ke he_ke hai_keh hai_k hai_ki
تھا کہ = tha_ke tha_ki tha_keh
کہنا کہ = kehna_ke kehna_k
معلوم ہوا کہ = maloom_hua_ke
اس لیے کہ = is_liye_ke is_lie_k isliye_ke
یہاں تک کہ = yahan_tak_ke yahan_tk_k
جیسا کہ = jaisa_ke jesa_k jaisa_k
جیسے کہ = jaise_ke jaise_ky jese_ke jaise_k

# postpositions
بعد میں = bad_me bad_mein baad_me baad_mein baad_mai bad_main
اس کے بعد = is_ke_bad us_ke_baad is_k_bad us_k_bad
کے لیے = ke_liye ke_lie k_lye k_liye ke_lye key_liye k_lie kay_liye ky_liye
کے بعد = ke_bad ke_baad k_bad k_baad
کے ساتھ = ke_sath k_sath ke_saath
کے پاس = ke_paas ke_pas k_pas
کی وجہ سے = ki_wajah_se ki_waja_se ki_wja_se
کی طرف سے = ki_taraf_se ki_traf_se
کی طرف = ki_taraf ki_traf
کی وجہ = ki_wajah ki_waja
گھر کا خرچ = ghar_ka_kharch ghr_ka_khrch

# لگا after a noun (the app word لاگا is first for "laga" alone, lead rule)
خرچہ لگا = kharcha_laga
خرچ لگا = kharch_laga
پیسہ لگا = paisa_laga
وقت لگا = waqt_laga
ٹائم لگا = time_laga tym_laga
کتنا لگا = kitna_laga
کرایہ لگا = kiraya_laga karaya_laga
ٹیکس لگا = tax_laga
جرمانہ لگا = jurmana_laga
تالا لگا = tala_laga
پتہ لگا = pata_laga
مجھے لگا = mujhe_laga
ایسا لگا = aisa_laga esa_laga
اچھا لگا = acha_laga accha_laga
برا لگا = bura_laga
نہیں لگا = nahi_laga nahin_laga
لگا دیا = laga_diya laga_dia
لگا دیے = laga_diye
لگا دی = laga_di
لگا ہوا = laga_hua
لگا تھا = laga_tha
جمع کرایا = jama_karaya jama_kraya jma_kraya
