{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window. Only our own commands and the plugin calls the shell needs. No shell, no general file access (NFR-SEC-10, Code Standards S4).",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-app-data-status",
    "allow-auth-status",
    "allow-setup-first-run",
    "allow-auth-login",
    "allow-auth-logout",
    "allow-auth-lock",
    "allow-auth-unlock",
    "allow-auth-recover",
    "allow-users-list",
    "allow-users-create",
    "allow-users-update",
    "allow-users-reset-password",
    "allow-settings-get",
    "allow-settings-set-firm",
    "allow-settings-set-security",
    "allow-settings-set-default-language",
    "allow-prefs-set",
    "allow-day-status",
    "core:event:default",
    "window-state:default",
    "updater:allow-check",
    "process:allow-restart",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm"
  ]
}
