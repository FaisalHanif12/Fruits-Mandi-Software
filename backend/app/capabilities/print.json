{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "print",
  "description": "The hidden print windows (labels print-*). They read the print data of one document and tell the backend the page is ready. Nothing else (NFR-SEC-10, plan 14).",
  "windows": ["print-*"],
  "permissions": [
    "allow-app-data-status",
    "allow-auth-status",
    "allow-reports-bikri-print-data",
    "allow-reports-collection-print-data",
    "allow-reports-voucher-print-data",
    "allow-reports-print-data",
    "allow-reports-buyer-bills-print-data",
    "allow-analytics-print-data",
    "allow-reports-print-header",
    "core:event:default"
  ]
}
