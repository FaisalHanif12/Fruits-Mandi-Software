      "$comment": "1 us. Per-line share of the 100 ms preview at 500 lines. README Section 6."
    },
    {
      "id": "money/parse_rupees",
      "action": "parse_rupees, one money text",
      "kind": "nfr",
      "nfr": "NFR-SPD-7 (budget)",
      "stat": "p95",
      "target_ms": 0.002,
