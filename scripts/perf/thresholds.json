      "kind": "nfr",
      "nfr": "NFR-SPD-7 (budget)",
      "stat": "p95",
      "target_ms": 0.005,
      "$comment": "5 us. Once per posting. README Section 6."
    },
    {
      "id": "money/split_by_bps_10",
      "action": "split_by_bps, 10 partners",
