### Locked business words, English column of PRD Section 3 (FR-7.37, NFR-URD-21).
### Same IDs as ur/glossary.ftl. Mandi words with no exact English word keep their Roman name.

# Commission agent (our client)
# review: pending
-arhti = Commission Agent (Arhti)

# Master list of all accounts
# review: pending
-index = Index

# Seller side: trader
# review: pending
-beopari = Seller

# Seller side: landowner
# review: pending
-zamindar = Zamindar

# Seller side: grower
# review: pending
-buzgar = Grower

# Buyer
# review: pending
-gahak = Buyer

# Buyer
# review: pending
-kharidar = Buyer

# Shared account for one-time or rare parties
# review: pending
-pukhta-khata = Pukhta Khata

# One unit or package (پیٹی، کریٹ، بوری، دانہ)
# review: pending
-nag = Nag

# Sale
# review: pending
-bikri = Sale

# Sale book; one بکری = one truck's goods sold
# review: pending
-bikri-book = Sale Book

# One seller's goods of one item on a truck
# review: pending
-lot = Lot

# Item
# review: pending
-qism-maal = Item

# Packing unit
# review: pending
-packing = Packing

# Mark on crates showing whose goods they are
# review: pending
-marka = Mark

# Truck stand the truck came from
# review: pending
-adda = Adda

# Gross sale before deductions
# review: pending
-kham-bikri = Gross Sale

# Net sale payable to seller
# review: pending
-safi-bikri = Net Sale

# Commission: percent, per نگ or per lot
# review: pending
-commission = Commission

# Small charge on the buyer, per نگ
# review: pending
-laga = Laga

# Labour (loading, unloading)
# review: pending
-mazdoori = Labour

# Munshi's fee, charged to the seller, paid to the munshi
# review: pending
-munshiana = Munshiana

# Truck freight
# review: pending
-kiraya = Freight

# Store or cold-storage rent
# review: pending
-kiraya-store = Store Rent

# Cash given to the seller at the time of sale
# review: pending
-naqd = Cash Paid

# Phone charge on the seller
# review: pending
-phone = Phone Charge

# The cash buyer with no name (system account 03040000)
# review: pending
-naqdi-mandi = Naqdi Mandi

# Buyer value minus seller amount when the two rates differ; firm income
# review: pending
-rate-farq = Rate Difference

# Credit sale
# review: pending
-udhari = Credit

# Cash sale
# review: pending
-naqdi = Cash

# Cash book
# review: pending
-rokar = Cash Book

# Receipt from a buyer
# review: pending
-wasooli = Receipt

# Collection of dues from credit buyers
# review: pending
-agrahi = Collection

# Payment out, mainly to sellers
# review: pending
-adaigi = Payment

# Advance given to a seller before his goods are sold
# review: pending
-peshgi-khata = Advance

# The advance itself (the money given), as against the screen and register.
# review: pending
-peshgi = Advance

# Money the shop lends to staff or anyone else, to be given back
# review: pending
-adhar-raqam = Money Lent

# Money given back: by a partner, by a person who borrowed, or by a seller returning his advance
# review: pending
-wapsi = Return

# Cash the shop lends to a buyer; it is collected with his other dues
# review: pending
-naqd-udhar = Cash Lent

# A partner's profit share minus the money he took and has not returned
# review: pending
-khalis = Net

# General journal entry
# review: pending
-general = Journal

# Expense
# review: pending
-kharcha = Expense

# Shop expense
# review: pending
-dukan-kharcha = Shop Expense

# A partner's personal drawing
# review: pending
-zati-kharcha = Personal Drawing

# An account kept apart from the partners, commission and profit (PRD Section 3, 16.6)
# review: pending
-alag-khata = Separate Khata

# Goods received but not yet sold
# review: pending
-stock = Unsold Stock

# Goods received but not yet sold
# review: pending
-baqi-maal = Unsold Stock

# Partner
# review: pending
-shirakat-dar = Partner

# Share
# review: pending
-hissa = Share

# Capital: money a partner invests in the shop (PRD Section 3)
# review: pending
-sarmaya = Capital

# Analytics
# review: pending
-tajziat = Analytics

# Daily journal
# review: pending
-roznamcha = Day Book

# Party ledger
# review: pending
-khata = Ledger

# Statement handed to a party
# review: pending
-fard-hisab = Statement

# Debit
# review: pending
-banaam = Debit

# Credit
# review: pending
-jama = Credit

# Total
# review: pending
-meezan = Total

# Trial balance
# review: pending
-trial-balance = Trial Balance

# Goods the firm buys itself and sells for its own profit or loss (PRD Section 3)
# review: pending
-apna-maal = Own Goods

# The firm buying its own goods (PRD Section 3)
# review: pending
-khareedari = Purchase

# Profit of a market trip or of one of its purchases (PRD Section 3)
# review: pending
-tijarati-munafa = Trading Profit

# Loss of a market trip or of one of its purchases (PRD Section 3)
# review: pending
-tijarati-nuqsan = Trading Loss

# A day trip to a bigger market to buy goods for some partners (PRD Section 3, 12.10)
# review: pending
-market-safar = Market Trip

# Where a partner's part of a payment comes from: the shop's cash (PRD Section 3, FR-12.29)
# review: pending
-dukan-se = From the Shop

# Where a partner's part of a payment comes from: his own money (PRD Section 3, FR-12.29)
# review: pending
-apni-jeb-se = Own Pocket

## The words on their own, for labels that show only the word.

# A partner's total in the firm: his investment plus his share of commission and profit, less what he took (PRD Section 3, C22)
# review: pending
-kul-raqam = Partner Total

# A garden rented by some partners for a season (PRD Section 3, 12.11)
# review: pending
-bagh = Garden

# A market trip, by its number (PRD Section 3, 12.10)
# review: pending
-safar = Trip

# Fruit a partner takes home, or fruit for the shop's guests (PRD Section 3, 16.7)
# review: pending
-phal = Fruit Taken

# The gardens as one word: the main bar item and the list title (PRD FR-5.2, 12.11)
# review: pending
-baghat = Gardens

# The price of a garden for the season, paid in installments (PRD Section 3, 12.11)
# review: pending
-thaika = Garden Rent

# One part of a garden's rent, paid on a date (PRD Section 3, 12.11)
# review: pending
-qist = Installment

# Where fruit comes from: a lot of our own shop, in باقی مال (PRD 16.7)
# review: pending
-apni-dukan = Our Shop

# Where fruit comes from: another commission agent's shop (PRD 16.7)
# review: pending
-dusri-dukan = Another Shop

# The shop's guests, who share the fruit served to them equally (PRD 16.7, C27)
# review: pending
-mehman = Guests

# A short tag after a name, in English capital letters, that tells two people with the same name apart (PRD Section 3, 10.2)
# review: pending
-nishan = Tag

# The firm's trade mark, printed in a box in every print header (PRD Section 21, FR-19.13)
# review: pending
-trade-mark = Trade Mark

